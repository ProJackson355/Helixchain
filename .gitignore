# ---------------------------------------------------------------------------
# Helix — Git ignore rules
# Keeps source, config.json, web/, and the download packages tracked, while
# excluding virtual environments, caches, and per-node runtime state.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test-results/
.ruff_cache/

# IDEs / editors
.idea/
.vscode/
*.swp

# OS junk
.DS_Store
Thumbs.db

# Cloudflare / Wrangler build cache and local secrets
.wrangler/
.dev.vars
.dev.vars.*

# Per-node runtime state (generated at run time, not source)
database_*.json
database_*.json.*
database_*.sqlite3
database_*.sqlite3-*
node_*.json
peers.json
pools.json
submissions.json
security_state.json
pool_gui_settings.json
.package_build_*/
backups/
*.tmp

# Wallet stores — sensitive, never commit
wallets.json
**/wallets.json
wallets.json.bak

# Logs
*.log

# Release signing secrets (publish only the .pub key)
release-signing.key
*.release-signing.key

# Note: web/downloads/*.zip (the node/miner/pool packages) are intentionally NOT
# ignored, because the site links to them and the tests check they exist.
# If you would rather build them on release instead of committing binaries,
# uncomment the next line:
# web/downloads/*.zip

# Auto-generated local checkpoints
auto_checkpoints_*.json
auto_checkpoints.json
