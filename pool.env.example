# Manual Helix Pool settings. Do not put a real seed in a file you share.
HELIX_POOL_SEED="replace with the pool payout wallet's 12 words"
# Use "web" for wallet.hlxchain.com seeds or "bip39" for Python/CLI wallets.
HELIX_POOL_SEED_FORMAT="web"
HELIX_POOL_NODE="https://node.hlxchain.com"
HELIX_POOL_HOST="0.0.0.0"
HELIX_POOL_PORT="8100"
HELIX_POOL_FEE_PERCENT="1.0"
HELIX_POOL_SHARE_SUBTRACT="2"
HELIX_POOL_MIN_SHARE_DIFFICULTY="1"
HELIX_POOL_PPLNS_WINDOW="10000"
HELIX_POOL_SHARE_SECONDS="15"
